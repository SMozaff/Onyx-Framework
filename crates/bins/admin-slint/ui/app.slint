import { Button, LineEdit, ComboBox, CheckBox } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: false;
    out property <color> background: dark ? #0f1720 : #f3f7fb;
    out property <color> surface: dark ? #17212d : #ffffff;
    out property <color> text: dark ? #e6edf5 : #102b4d;
    out property <color> text-dim: dark ? #9fb0c3 : #5d7088;
    out property <color> accent: #1f6098;
    out property <color> danger: dark ? #f97066 : #b42318;
}

export struct OrgItem {
    id: string,
    name: string,
    active: bool,
}

export struct AdminItem {
    id: string,
    username: string,
    active: bool,
}

export struct UserItem {
    id: string,
    username: string,
    class: string,
    parent: string,
    active: bool,
}

export global Strings {
    in-out property <string> app-title;
    in-out property <string> theme-light;
    in-out property <string> theme-dark;
    in-out property <string> english;
    in-out property <string> farsi;
    in-out property <string> admin-title;
    in-out property <string> sign-in-heading;
    in-out property <string> sign-in-description;
    in-out property <string> username-label;
    in-out property <string> password-label;
    in-out property <string> sign-in-button;
    in-out property <string> signing-in-button;
    in-out property <string> signed-in-label;
    in-out property <string> sign-out-button;
    in-out property <string> nav-users;
    in-out property <string> nav-settings;
    in-out property <string> nav-profiles;
    in-out property <string> nav-organizations;
    in-out property <string> no-data;
    in-out property <string> status-active;
    in-out property <string> status-inactive;
    in-out property <string> loading;
    in-out property <string> create-user-button;
    in-out property <string> email-label;
    in-out property <string> class-label;
    in-out property <string> parent-label;
    in-out property <string> save-button;
    in-out property <string> activate-button;
    in-out property <string> deactivate-button;
    in-out property <string> name-label;
    in-out property <string> create-org-button;
    in-out property <string> create-admin-button;
    in-out property <string> organization-label;
    in-out property <string> admins-heading;
    in-out property <string> mobile-heading;
    in-out property <string> mobile-save-button;
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 40px;
    border-radius: 6px;
    background: root.active ? Theme.accent : transparent;
    Text {
        text: root.label;
        color: root.active ? white : Theme.text;
        vertical-alignment: center;
        horizontal-alignment: left;
        x: 12px;
        width: parent.width - 24px;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: Strings.app-title;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.background;

    in-out property <bool> signed-in: false;
    in-out property <bool> busy: false;
    in-out property <bool> is-all-father: false;
    in-out property <int> page: 0;
    in-out property <string> error-text: "";
    in-out property <string> signed-in-as: "";
    in-out property <[UserItem]> users: [];
    in-out property <string> users-error: "";
    in-out property <bool> users-loading: false;
    in-out property <bool> mobile-top: false;
    in-out property <bool> mobile-senior: false;
    in-out property <bool> mobile-team: false;
    in-out property <bool> mobile-supervisor: false;
    in-out property <bool> mobile-staff: false;
    in-out property <int> mobile-version: 0;
    in-out property <string> mobile-status: "";
    in-out property <[OrgItem]> orgs: [];
    in-out property <[AdminItem]> org-admins: [];
    in-out property <string> selected-org-id: "";
    in-out property <string> selected-org-name: "";
    in-out property <[string]> class-options: ["", "top_level_manager", "senior_manager", "team_leader", "supervisor", "staff"];

    callback select-language(string);
    callback sign-in(string, string);
    callback sign-out();
    callback select-page(int);
    callback create-user(string, string, string, string);
    callback set-class(string, string);
    callback set-parent(string, string);
    callback toggle-active(string, bool);
    callback create-org(string);
    callback rename-org(string, string);
    callback toggle-org(string, bool);
    callback select-org(string);
    callback create-org-admin(string, string, string);
    callback toggle-admin(string, bool);
    callback save-mobile-access(bool, bool, bool, bool, bool);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: Strings.english;
                clicked => { root.select-language("en"); }
            }
            Button {
                text: Strings.farsi;
                clicked => { root.select-language("fa"); }
            }
            Button {
                text: Theme.dark ? Strings.theme-light : Strings.theme-dark;
                clicked => { Theme.dark = !Theme.dark; }
            }
        }

        if !root.signed-in: Rectangle {
            background: Theme.surface;
            border-radius: 8px;
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                alignment: start;

                Text {
                    text: Strings.admin-title;
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: 700;
                }
                Text {
                    text: Strings.sign-in-heading;
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 700;
                }
                Text {
                    text: Strings.sign-in-description;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                if root.error-text != "": Text {
                    text: root.error-text;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
                Text {
                    text: Strings.username-label;
                    color: Theme.text;
                }
                username := LineEdit {
                    enabled: !root.busy;
                }
                Text {
                    text: Strings.password-label;
                    color: Theme.text;
                }
                password := LineEdit {
                    input-type: InputType.password;
                    enabled: !root.busy;
                }
                Button {
                    text: root.busy ? Strings.signing-in-button : Strings.sign-in-button;
                    enabled: !root.busy;
                    clicked => { root.sign-in(username.text, password.text); }
                }
            }
        }

        if root.signed-in: HorizontalLayout {
            spacing: 12px;

            Rectangle {
                width: 220px;
                background: Theme.surface;
                border-radius: 8px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: Strings.signed-in-label + " " + root.signed-in-as;
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    NavButton {
                        label: Strings.nav-users;
                        active: root.page == 0;
                        clicked => { root.page = 0; root.select-page(0); }
                    }
                    NavButton {
                        label: Strings.nav-settings;
                        active: root.page == 1;
                        clicked => { root.page = 1; }
                    }
                    NavButton {
                        label: Strings.nav-profiles;
                        active: root.page == 2;
                        clicked => { root.page = 2; }
                    }
                    if root.is-all-father: NavButton {
                        label: Strings.nav-organizations;
                        active: root.page == 3;
                        clicked => { root.page = 3; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Button {
                        text: Strings.sign-out-button;
                        clicked => { root.sign-out(); }
                    }
                }
            }

            Rectangle {
                background: Theme.surface;
                border-radius: 8px;
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: root.page == 0 ? Strings.nav-users
                            : root.page == 1 ? Strings.nav-settings
                            : root.page == 2 ? Strings.nav-profiles
                            : Strings.nav-organizations;
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 700;
                    }
                    if root.page == 0 && root.users-loading: Text {
                        text: Strings.loading;
                        color: Theme.text-dim;
                    }
                    if root.page == 0 && root.users-error != "": Text {
                        text: root.users-error;
                        color: Theme.danger;
                        wrap: word-wrap;
                    }
                    if root.page == 0: VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            new-username := LineEdit { placeholder-text: Strings.username-label; }
                            new-email := LineEdit { placeholder-text: Strings.email-label; }
                            new-password := LineEdit { placeholder-text: Strings.password-label; input-type: InputType.password; }
                            new-class := ComboBox { model: root.class-options; }
                            Button {
                                text: Strings.create-user-button;
                                clicked => { root.create-user(new-username.text, new-email.text, new-password.text, new-class.current-value); }
                            }
                        }
                        for item in root.users: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: item.username + " · " + (item.active ? Strings.status-active : Strings.status-inactive);
                                color: Theme.text;
                                width: 240px;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                model: root.class-options;
                                current-value: item.class;
                                selected(value) => { root.set-class(item.id, value); }
                            }
                            parent-entry := LineEdit {
                                placeholder-text: Strings.parent-label;
                                text: item.parent;
                            }
                            Button {
                                text: Strings.save-button;
                                clicked => { root.set-parent(item.id, parent-entry.text); }
                            }
                            Button {
                                text: item.active ? Strings.deactivate-button : Strings.activate-button;
                                clicked => { root.toggle-active(item.id, !item.active); }
                            }
                        }
                    }
                    if root.page == 3: VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            new-org-name := LineEdit { placeholder-text: Strings.name-label; }
                            Button {
                                text: Strings.create-org-button;
                                clicked => { root.create-org(new-org-name.text); }
                            }
                        }
                        for org in root.orgs: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: org.name + " · " + (org.active ? Strings.status-active : Strings.status-inactive);
                                color: Theme.text;
                                width: 260px;
                                vertical-alignment: center;
                            }
                            org-rename := LineEdit { text: org.name; }
                            Button {
                                text: Strings.save-button;
                                clicked => { root.rename-org(org.id, org-rename.text); }
                            }
                            Button {
                                text: org.active ? Strings.deactivate-button : Strings.activate-button;
                                clicked => { root.toggle-org(org.id, !org.active); }
                            }
                            Button {
                                text: Strings.admins-heading;
                                clicked => { root.select-org(org.id); }
                            }
                        }
                        if root.selected-org-id != "": VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: Strings.admins-heading + " · " + root.selected-org-name;
                                color: Theme.text;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                admin-username := LineEdit { placeholder-text: Strings.username-label; }
                                admin-email := LineEdit { placeholder-text: Strings.email-label; }
                                admin-password := LineEdit { placeholder-text: Strings.password-label; input-type: InputType.password; }
                                Button {
                                    text: Strings.create-admin-button;
                                    clicked => { root.create-org-admin(admin-username.text, admin-email.text, admin-password.text); }
                                }
                            }
                            for admin in root.org-admins: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: admin.username + " · " + (admin.active ? Strings.status-active : Strings.status-inactive);
                                    color: Theme.text;
                                    width: 260px;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: admin.active ? Strings.deactivate-button : Strings.activate-button;
                                    clicked => { root.toggle-admin(admin.id, !admin.active); }
                                }
                            }
                        }
                    }
                    if root.page == 1: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: Strings.mobile-heading;
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.mobile-status;
                            color: Theme.text-dim;
                        }
                        CheckBox { text: "top_level_manager"; checked: root.mobile-top; toggled => { root.mobile-top = self.checked; } }
                        CheckBox { text: "senior_manager"; checked: root.mobile-senior; toggled => { root.mobile-senior = self.checked; } }
                        CheckBox { text: "team_leader"; checked: root.mobile-team; toggled => { root.mobile-team = self.checked; } }
                        CheckBox { text: "supervisor"; checked: root.mobile-supervisor; toggled => { root.mobile-supervisor = self.checked; } }
                        CheckBox { text: "staff"; checked: root.mobile-staff; toggled => { root.mobile-staff = self.checked; } }
                        Button {
                            text: Strings.mobile-save-button;
                            clicked => {
                                root.save-mobile-access(root.mobile-top, root.mobile-senior, root.mobile-team, root.mobile-supervisor, root.mobile-staff);
                            }
                        }
                    }
                    if root.page == 2: Text {
                        text: Strings.no-data;
                        color: Theme.text-dim;
                    }
                }
            }
        }
    }
}
