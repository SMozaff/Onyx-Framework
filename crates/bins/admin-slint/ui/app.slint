import { Button, LineEdit, ComboBox, CheckBox } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: false;
    out property <color> background: dark ? #0f1720 : #f3f7fb;
    out property <color> surface: dark ? #17212d : #ffffff;
    out property <color> text: dark ? #e6edf5 : #102b4d;
    out property <color> text-dim: dark ? #9fb0c3 : #5d7088;
    out property <color> accent: #1f6098;
    out property <color> danger: dark ? #f97066 : #b42318;
}

export struct ProfileItem {
    owner: string,
    name: string,
    title: string,
    department: string,
    class: string,
    email: string,
    phone: string,
    parent: string,
    teams: string,
    photo: string,
}

export struct PolicyItem {
    id: string,
    name: string,
    status: string,
    version: int,
}

export struct OrgItem {
    id: string,
    name: string,
    active: bool,
}

export struct AdminItem {
    id: string,
    username: string,
    active: bool,
}

export struct UserItem {
    id: string,
    username: string,
    class: string,
    parent: string,
    active: bool,
}

export struct HoldItem {
    id: string,
    status: string,
}

export struct PendingRuleItem {
    rule-type: string,
    key: string,
    value: string,
}

export global Strings {
    in-out property <string> app-title;
    in-out property <string> theme-light;
    in-out property <string> theme-dark;
    in-out property <string> english;
    in-out property <string> farsi;
    in-out property <string> admin-title;
    in-out property <string> sign-in-heading;
    in-out property <string> sign-in-description;
    in-out property <string> username-label;
    in-out property <string> password-label;
    in-out property <string> sign-in-button;
    in-out property <string> signing-in-button;
    in-out property <string> signed-in-label;
    in-out property <string> sign-out-button;
    in-out property <string> nav-users;
    in-out property <string> nav-settings;
    in-out property <string> nav-profiles;
    in-out property <string> nav-organizations;
    in-out property <string> no-data;
    in-out property <string> status-active;
    in-out property <string> status-inactive;
    in-out property <string> loading;
    in-out property <string> create-user-button;
    in-out property <string> email-label;
    in-out property <string> class-label;
    in-out property <string> parent-label;
    in-out property <string> save-button;
    in-out property <string> activate-button;
    in-out property <string> deactivate-button;
    in-out property <string> name-label;
    in-out property <string> create-org-button;
    in-out property <string> create-admin-button;
    in-out property <string> organization-label;
    in-out property <string> admins-heading;
    in-out property <string> mobile-heading;
    in-out property <string> mobile-save-button;
    in-out property <string> policy-heading;
    in-out property <string> create-policy-button;
    in-out property <string> policy-name-placeholder;
    in-out property <string> publish-button;
    in-out property <string> retire-button;
    in-out property <string> evaluate-button;
    in-out property <string> rule-key-placeholder;
    in-out property <string> rule-type-label;
    in-out property <string> add-rule-button;
    in-out property <string> create-version-button;
    in-out property <string> rules-pending-label;
    in-out property <string> rule-value-placeholder;
    in-out property <string> legal-holds-heading;
    in-out property <string> target-id-placeholder;
    in-out property <string> target-type-placeholder;
    in-out property <string> reason-placeholder;
    in-out property <string> apply-legal-hold-button;
    in-out property <string> view-hold-placeholder;
    in-out property <string> view-button;
    in-out property <string> release-button;
    in-out property <string> profiles-heading;
    in-out property <string> save-profile-button;
    in-out property <string> import-button;
    in-out property <string> export-csv-button;
    in-out property <string> export-json-button;
    in-out property <string> owner-label;
    in-out property <string> full-name-label;
    in-out property <string> job-title-label;
    in-out property <string> contact-email-label;
    in-out property <string> contact-phone-label;
    in-out property <string> department-label;
    in-out property <string> team-label;
    in-out property <string> photo-label;
    in-out property <string> import-from-excel;
    in-out property <string> show-details;
    in-out property <string> hide-details;
    in-out property <string> remove-rule;
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 40px;
    border-radius: 6px;
    background: root.active ? Theme.accent : transparent;
    Text {
        text: root.label;
        color: root.active ? white : Theme.text;
        vertical-alignment: center;
        horizontal-alignment: left;
        x: 12px;
        width: parent.width - 24px;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: Strings.app-title;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.background;

    in-out property <bool> signed-in: false;
    in-out property <bool> busy: false;
    in-out property <bool> is-all-father: false;
    in-out property <int> page: 0;
    in-out property <string> error-text: "";
    in-out property <string> signed-in-as: "";
    in-out property <[UserItem]> users: [];
    in-out property <string> users-error: "";
    in-out property <bool> users-loading: false;
    in-out property <string> create-user-username: "";
    in-out property <string> create-user-email: "";
    in-out property <string> create-user-password: "";
    in-out property <bool> mobile-top: false;
    in-out property <bool> mobile-senior: false;
    in-out property <bool> mobile-team: false;
    in-out property <bool> mobile-supervisor: false;
    in-out property <bool> mobile-staff: false;
    in-out property <int> mobile-version: 0;
    in-out property <string> mobile-status: "";
    in-out property <[ProfileItem]> profiles: [];
    in-out property <[PolicyItem]> policies: [];
    in-out property <string> policy-error: "";
    in-out property <string> policy-status: "";
    in-out property <string> policy-name-input: "";
    in-out property <bool> policy-command-busy: false;
    in-out property <string> policy-rule-key: "";
    in-out property <string> selected-policy-id: "";
    in-out property <string> rule-type-input: "FeatureToggle";
    in-out property <string> rule-key-input: "";
    in-out property <string> rule-value-input: "";
    in-out property <int> rules-pending: 0;
    in-out property <string> selected-policy-name: "";
    in-out property <string> selected-policy-status: "";
    in-out property <int> selected-policy-version: 0;
    in-out property <[PendingRuleItem]> pending-rules: [];
    in-out property <string> policy-evaluation-detail: "";
    in-out property <bool> policy-evaluation-detail-visible: false;
    in-out property <string> legal-hold-error: "";
    in-out property <[HoldItem]> legal-holds: [];
    in-out property <string> legal-hold-target-input: "";
    in-out property <string> legal-hold-type-input: "";
    in-out property <string> legal-hold-reason-input: "";
    in-out property <string> legal-hold-release-reason-input: "";
    in-out property <string> legal-hold-view-id: "";
    in-out property <string> legal-hold-selected-id: "";
    in-out property <string> legal-hold-state: "";
    in-out property <bool> legal-hold-can-release: false;
    in-out property <string> form-owner: "";
    in-out property <string> form-name: "";
    in-out property <string> form-title: "";
    in-out property <string> form-email: "";
    in-out property <string> form-phone: "";
    in-out property <string> form-department: "";
    in-out property <string> form-class: "";
    in-out property <string> form-parent: "";
    in-out property <string> form-teams: "";
    in-out property <string> form-photo: "";
    in-out property <string> import-status: "";
    in-out property <[OrgItem]> orgs: [];
    in-out property <[AdminItem]> org-admins: [];
    in-out property <string> selected-org-id: "";
    in-out property <string> selected-org-name: "";
    in-out property <bool> selected-org-active: false;
    in-out property <string> org-create-name: "";
    in-out property <string> org-admin-username: "";
    in-out property <string> org-admin-email: "";
    in-out property <string> org-admin-password: "";
    in-out property <[string]> class-options: ["", "top_level_manager", "senior_manager", "team_leader", "supervisor", "staff"];

    callback select-language(string);
    callback sign-in(string, string);
    callback sign-out();
    callback select-page(int);
    callback create-user(string, string, string, string);
    callback set-class(string, string);
    callback set-parent(string, string);
    callback toggle-active(string, bool);
    callback create-org(string);
    callback rename-org(string, string);
    callback toggle-org(string, bool);
    callback select-org(string);
    callback create-org-admin(string, string, string);
    callback toggle-admin(string, bool);
    callback save-mobile-access(bool, bool, bool, bool, bool);
    callback create-policy(string);
    callback select-policy(string);
    callback publish-policy();
    callback retire-policy();
    callback evaluate-policy(string);
    callback add-policy-rule(string, string, string);
    callback remove-policy-rule(int);
    callback create-policy-version();
    callback toggle-policy-evaluation-detail();
    callback apply-legal-hold(string, string, string);
    callback select-legal-hold(string);
    callback view-legal-hold(string);
    callback release-legal-hold();
    callback save-profile();
    callback import-profiles();
    callback export-profiles(string);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: Strings.english;
                clicked => { root.select-language("en"); }
            }
            Button {
                text: Strings.farsi;
                clicked => { root.select-language("fa"); }
            }
            Button {
                text: Theme.dark ? Strings.theme-light : Strings.theme-dark;
                clicked => { Theme.dark = !Theme.dark; }
            }
        }

        if !root.signed-in: Rectangle {
            background: Theme.surface;
            border-radius: 8px;
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                alignment: start;

                Text {
                    text: Strings.admin-title;
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: 700;
                }
                Text {
                    text: Strings.sign-in-heading;
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 700;
                }
                Text {
                    text: Strings.sign-in-description;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                if root.error-text != "": Text {
                    text: root.error-text;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
                Text {
                    text: Strings.username-label;
                    color: Theme.text;
                }
                username := LineEdit {
                    enabled: !root.busy;
                }
                Text {
                    text: Strings.password-label;
                    color: Theme.text;
                }
                password := LineEdit {
                    input-type: InputType.password;
                    enabled: !root.busy;
                }
                Button {
                    text: root.busy ? Strings.signing-in-button : Strings.sign-in-button;
                    enabled: !root.busy;
                    clicked => { root.sign-in(username.text, password.text); }
                }
            }
        }

        if root.signed-in: HorizontalLayout {
            spacing: 12px;

            Rectangle {
                width: 220px;
                background: Theme.surface;
                border-radius: 8px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: Strings.signed-in-label + " " + root.signed-in-as;
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    NavButton {
                        label: Strings.nav-users;
                        active: root.page == 0;
                        clicked => { root.page = 0; root.select-page(0); }
                    }
                    NavButton {
                        label: Strings.nav-settings;
                        active: root.page == 1;
                        clicked => { root.page = 1; root.select-page(1); }
                    }
                    NavButton {
                        label: Strings.nav-profiles;
                        active: root.page == 2;
                        clicked => { root.page = 2; root.select-page(2); }
                    }
                    if root.is-all-father: NavButton {
                        label: Strings.nav-organizations;
                        active: root.page == 3;
                        clicked => { root.page = 3; root.select-page(3); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Button {
                        text: Strings.sign-out-button;
                        clicked => { root.sign-out(); }
                    }
                }
            }

            Rectangle {
                background: Theme.surface;
                border-radius: 8px;
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: root.page == 0 ? Strings.nav-users
                            : root.page == 1 ? Strings.nav-settings
                            : root.page == 2 ? Strings.nav-profiles
                            : Strings.nav-organizations;
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 700;
                    }
                    if root.page == 0 && root.users-loading: Text {
                        text: Strings.loading;
                        color: Theme.text-dim;
                    }
                    if root.page == 0 && root.users-error != "": Text {
                        text: root.users-error;
                        color: Theme.danger;
                        wrap: word-wrap;
                    }
                    if root.page == 0: VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            new-username := LineEdit {
                                placeholder-text: Strings.username-label;
                                text <=> root.create-user-username;
                            }
                            new-email := LineEdit {
                                placeholder-text: Strings.email-label;
                                text <=> root.create-user-email;
                            }
                            new-password := LineEdit {
                                placeholder-text: Strings.password-label;
                                input-type: InputType.password;
                                text <=> root.create-user-password;
                            }
                            new-class := ComboBox { model: root.class-options; }
                            Button {
                                text: Strings.create-user-button;
                                enabled: root.create-user-username != "" && root.create-user-email != "" && root.create-user-password != "" && !root.users-loading;
                                clicked => { root.create-user(new-username.text, new-email.text, new-password.text, new-class.current-value); }
                            }
                        }
                        for item in root.users: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: item.username + " · " + (item.active ? Strings.status-active : Strings.status-inactive);
                                color: Theme.text;
                                width: 240px;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                model: root.class-options;
                                current-value: item.class;
                                selected(value) => { root.set-class(item.id, value); }
                            }
                            parent-entry := LineEdit {
                                placeholder-text: Strings.parent-label;
                                text: item.parent;
                            }
                            Button {
                                text: Strings.save-button;
                                clicked => { root.set-parent(item.id, parent-entry.text); }
                            }
                            Button {
                                text: item.active ? Strings.deactivate-button : Strings.activate-button;
                                clicked => { root.toggle-active(item.id, !item.active); }
                            }
                        }
                    }
                    if root.page == 3: VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            new-org-name := LineEdit {
                                placeholder-text: Strings.name-label;
                                text <=> root.org-create-name;
                            }
                            Button {
                                text: Strings.create-org-button;
                                enabled: root.org-create-name != "" && !root.users-loading;
                                clicked => { root.create-org(new-org-name.text); }
                            }
                        }
                        for org in root.orgs: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: org.name + " · " + (org.active ? Strings.status-active : Strings.status-inactive);
                                color: Theme.text;
                                width: 260px;
                                vertical-alignment: center;
                            }
                            org-rename := LineEdit { text: org.name; }
                            Button {
                                text: Strings.save-button;
                                enabled: org-rename.text != org.name && !root.users-loading;
                                clicked => { root.rename-org(org.id, org-rename.text); }
                            }
                            Button {
                                text: org.active ? Strings.deactivate-button : Strings.activate-button;
                                enabled: !root.users-loading;
                                clicked => { root.toggle-org(org.id, !org.active); }
                            }
                            Button {
                                text: Strings.admins-heading;
                                enabled: !root.users-loading;
                                clicked => { root.select-org(org.id); }
                            }
                        }
                        if root.selected-org-id != "": VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: Strings.admins-heading + " · " + root.selected-org-name;
                                color: Theme.text;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                admin-username := LineEdit {
                                    placeholder-text: Strings.username-label;
                                    text <=> root.org-admin-username;
                                }
                                admin-email := LineEdit {
                                    placeholder-text: Strings.email-label;
                                    text <=> root.org-admin-email;
                                }
                                admin-password := LineEdit {
                                    placeholder-text: Strings.password-label;
                                    input-type: InputType.password;
                                    text <=> root.org-admin-password;
                                }
                                Button {
                                    text: Strings.create-admin-button;
                                    enabled: root.selected-org-active && root.org-admin-username != "" && root.org-admin-email != "" && root.org-admin-password != "" && !root.users-loading;
                                    clicked => { root.create-org-admin(admin-username.text, admin-email.text, admin-password.text); }
                                }
                            }
                            for admin in root.org-admins: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: admin.username + " · " + (admin.active ? Strings.status-active : Strings.status-inactive);
                                    color: Theme.text;
                                    width: 260px;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: admin.active ? Strings.deactivate-button : Strings.activate-button;
                                    enabled: !root.users-loading;
                                    clicked => { root.toggle-admin(admin.id, !admin.active); }
                                }
                            }
                        }
                    }
                    if root.page == 1: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: Strings.mobile-heading;
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.mobile-status;
                            color: Theme.text-dim;
                        }
                        CheckBox { text: "top_level_manager"; checked: root.mobile-top; toggled => { root.mobile-top = self.checked; } }
                        CheckBox { text: "senior_manager"; checked: root.mobile-senior; toggled => { root.mobile-senior = self.checked; } }
                        CheckBox { text: "team_leader"; checked: root.mobile-team; toggled => { root.mobile-team = self.checked; } }
                        CheckBox { text: "supervisor"; checked: root.mobile-supervisor; toggled => { root.mobile-supervisor = self.checked; } }
                        CheckBox { text: "staff"; checked: root.mobile-staff; toggled => { root.mobile-staff = self.checked; } }
                        Button {
                            text: Strings.mobile-save-button;
                            enabled: !root.users-loading;
                            clicked => {
                                root.save-mobile-access(root.mobile-top, root.mobile-senior, root.mobile-team, root.mobile-supervisor, root.mobile-staff);
                            }
                        }
                    }
                    if root.page == 1: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: Strings.policy-heading;
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.policy-error;
                            color: Theme.text-dim;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                placeholder-text: Strings.policy-name-placeholder;
                                text <=> root.policy-name-input;
                            }
                            Button {
                                text: Strings.create-policy-button;
                                enabled: root.policy-name-input != "" && !root.policy-command-busy;
                                clicked => { root.create-policy(root.policy-name-input); }
                            }
                        }
                        for policy in root.policies: Button {
                            text: policy.name + " · " + policy.status + " · v" + policy.version;
                            clicked => { root.select-policy(policy.id); }
                        }
                        if root.selected-policy-id != "": VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: root.selected-policy-name + " · " + root.selected-policy-status + " · v" + root.selected-policy-version;
                                color: Theme.text;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: Strings.publish-button;
                                    enabled: !root.policy-command-busy;
                                    clicked => { root.publish-policy(); }
                                }
                                Button {
                                    text: Strings.retire-button;
                                    enabled: !root.policy-command-busy;
                                    clicked => { root.retire-policy(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: Strings.rule-type-label;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: ["FeatureToggle", "Threshold", "Authorization", "Retention"];
                                    current-value <=> root.rule-type-input;
                                }
                                LineEdit {
                                    placeholder-text: Strings.rule-key-placeholder;
                                    text <=> root.rule-key-input;
                                }
                                LineEdit {
                                    placeholder-text: Strings.rule-value-placeholder;
                                    text <=> root.rule-value-input;
                                }
                                Button {
                                    text: Strings.add-rule-button;
                                    clicked => { root.add-policy-rule(root.rule-type-input, root.rule-key-input, root.rule-value-input); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: Strings.rules-pending-label + ": " + root.rules-pending;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: Strings.create-version-button;
                                    enabled: root.rules-pending > 0 && !root.policy-command-busy;
                                    clicked => { root.create-policy-version(); }
                                }
                            }
                            for rule[index] in root.pending-rules: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: rule.rule-type + " · " + rule.key + " = " + rule.value;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                Button {
                                    text: Strings.remove-rule;
                                    clicked => { root.remove-policy-rule(index); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    placeholder-text: Strings.rule-key-placeholder;
                                    text <=> root.policy-rule-key;
                                }
                                Button {
                                    text: Strings.evaluate-button;
                                    enabled: root.policy-rule-key != "" && !root.policy-command-busy;
                                    clicked => { root.evaluate-policy(root.policy-rule-key); }
                                }
                            }
                            Text {
                                text: root.policy-status;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                            }
                            if root.policy-evaluation-detail != "": VerticalLayout {
                                spacing: 4px;
                                Button {
                                    text: root.policy-evaluation-detail-visible ? Strings.hide-details : Strings.show-details;
                                    clicked => { root.toggle-policy-evaluation-detail(); }
                                }
                                if root.policy-evaluation-detail-visible: Text {
                                    text: root.policy-evaluation-detail;
                                    color: Theme.text;
                                    font-family: "monospace";
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    if root.page == 1: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: Strings.legal-holds-heading;
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.legal-hold-error;
                            color: Theme.text-dim;
                        }
                        for hold in root.legal-holds: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: hold.id + " · " + hold.status;
                                color: Theme.text;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            Button {
                                text: Strings.view-button;
                                clicked => { root.select-legal-hold(hold.id); }
                            }
                        }
                        LineEdit {
                            placeholder-text: Strings.target-id-placeholder;
                            text <=> root.legal-hold-target-input;
                        }
                        LineEdit {
                            placeholder-text: Strings.target-type-placeholder;
                            text <=> root.legal-hold-type-input;
                        }
                        LineEdit {
                            placeholder-text: Strings.reason-placeholder;
                            text <=> root.legal-hold-reason-input;
                        }
                        Button {
                            text: Strings.apply-legal-hold-button;
                            enabled: root.legal-hold-target-input != "" && root.legal-hold-type-input != "" && root.legal-hold-reason-input != "" && !root.users-loading;
                            clicked => {
                                root.apply-legal-hold(root.legal-hold-target-input, root.legal-hold-type-input, root.legal-hold-reason-input);
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                placeholder-text: Strings.view-hold-placeholder;
                                text <=> root.legal-hold-view-id;
                            }
                            Button {
                                text: Strings.view-button;
                                clicked => { root.view-legal-hold(root.legal-hold-view-id); }
                            }
                        }
                        if root.legal-hold-selected-id != "": VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: root.legal-hold-state;
                                color: Theme.text;
                            }
                            if root.legal-hold-can-release: VerticalLayout {
                                spacing: 6px;
                                LineEdit {
                                    placeholder-text: Strings.reason-placeholder;
                                    text <=> root.legal-hold-release-reason-input;
                                }
                                Button {
                                    text: Strings.release-button;
                                    enabled: root.legal-hold-release-reason-input != "" && !root.users-loading;
                                    clicked => { root.release-legal-hold(); }
                                }
                            }
                        }
                    }
                    if root.page == 2: VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: Strings.export-csv-button;
                                clicked => { root.export-profiles("csv"); }
                            }
                            Button {
                                text: Strings.export-json-button;
                                clicked => { root.export-profiles("json"); }
                            }
                            Button {
                                text: Strings.import-from-excel;
                                clicked => { root.import-profiles(); }
                            }
                        }
                        if root.import-status != "": Text {
                            text: root.import-status;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: Strings.profiles-heading;
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit { placeholder-text: Strings.owner-label; text <=> root.form-owner; }
                            LineEdit { placeholder-text: Strings.full-name-label; text <=> root.form-name; }
                            LineEdit { placeholder-text: Strings.job-title-label; text <=> root.form-title; }
                            LineEdit { placeholder-text: Strings.department-label; text <=> root.form-department; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit { placeholder-text: Strings.contact-email-label; text <=> root.form-email; }
                            LineEdit { placeholder-text: Strings.contact-phone-label; text <=> root.form-phone; }
                            LineEdit { placeholder-text: Strings.team-label; text <=> root.form-teams; }
                            LineEdit { placeholder-text: Strings.class-label; text <=> root.form-class; }
                            LineEdit { placeholder-text: Strings.parent-label; text <=> root.form-parent; }
                        }
                        Button {
                            text: Strings.save-profile-button;
                            clicked => { root.save-profile(); }
                        }
                        for profile in root.profiles: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: profile.name + " · " + profile.title + " · " + profile.department;
                                color: Theme.text;
                                width: 420px;
                                vertical-alignment: center;
                            }
                            Button {
                                text: Strings.save-button;
                                clicked => {
                                    root.form-owner = profile.owner;
                                    root.form-name = profile.name;
                                    root.form-title = profile.title;
                                    root.form-department = profile.department;
                                    root.form-class = profile.class;
                                    root.form-email = profile.email;
                                    root.form-phone = profile.phone;
                                    root.form-parent = profile.parent;
                                    root.form-teams = profile.teams;
                                    root.form-photo = profile.photo;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
