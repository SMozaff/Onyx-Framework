import { Button, LineEdit } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: false;
    out property <color> background: dark ? #0f1720 : #f3f7fb;
    out property <color> surface: dark ? #17212d : #ffffff;
    out property <color> text: dark ? #e6edf5 : #102b4d;
    out property <color> text-dim: dark ? #9fb0c3 : #5d7088;
    out property <color> accent: #1f6098;
    out property <color> danger: dark ? #f97066 : #b42318;
}

export struct UserItem {
    username: string,
    detail: string,
    active: bool,
}

export global Strings {
    in-out property <string> app-title;
    in-out property <string> theme-light;
    in-out property <string> theme-dark;
    in-out property <string> english;
    in-out property <string> farsi;
    in-out property <string> admin-title;
    in-out property <string> sign-in-heading;
    in-out property <string> sign-in-description;
    in-out property <string> username-label;
    in-out property <string> password-label;
    in-out property <string> sign-in-button;
    in-out property <string> signing-in-button;
    in-out property <string> signed-in-label;
    in-out property <string> sign-out-button;
    in-out property <string> nav-users;
    in-out property <string> nav-settings;
    in-out property <string> nav-profiles;
    in-out property <string> nav-organizations;
    in-out property <string> no-data;
    in-out property <string> status-active;
    in-out property <string> status-inactive;
    in-out property <string> loading;
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 40px;
    border-radius: 6px;
    background: root.active ? Theme.accent : transparent;
    Text {
        text: root.label;
        color: root.active ? white : Theme.text;
        vertical-alignment: center;
        horizontal-alignment: left;
        x: 12px;
        width: parent.width - 24px;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: Strings.app-title;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.background;

    in-out property <bool> signed-in: false;
    in-out property <bool> busy: false;
    in-out property <bool> is-all-father: false;
    in-out property <int> page: 0;
    in-out property <string> error-text: "";
    in-out property <string> signed-in-as: "";
    in-out property <[UserItem]> users: [];
    in-out property <string> users-error: "";
    in-out property <bool> users-loading: false;

    callback select-language(string);
    callback sign-in(string, string);
    callback sign-out();
    callback select-page(int);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: Strings.english;
                clicked => { root.select-language("en"); }
            }
            Button {
                text: Strings.farsi;
                clicked => { root.select-language("fa"); }
            }
            Button {
                text: Theme.dark ? Strings.theme-light : Strings.theme-dark;
                clicked => { Theme.dark = !Theme.dark; }
            }
        }

        if !root.signed-in: Rectangle {
            background: Theme.surface;
            border-radius: 8px;
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                alignment: start;

                Text {
                    text: Strings.admin-title;
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: 700;
                }
                Text {
                    text: Strings.sign-in-heading;
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 700;
                }
                Text {
                    text: Strings.sign-in-description;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                if root.error-text != "": Text {
                    text: root.error-text;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
                Text {
                    text: Strings.username-label;
                    color: Theme.text;
                }
                username := LineEdit {
                    enabled: !root.busy;
                }
                Text {
                    text: Strings.password-label;
                    color: Theme.text;
                }
                password := LineEdit {
                    input-type: InputType.password;
                    enabled: !root.busy;
                }
                Button {
                    text: root.busy ? Strings.signing-in-button : Strings.sign-in-button;
                    enabled: !root.busy;
                    clicked => { root.sign-in(username.text, password.text); }
                }
            }
        }

        if root.signed-in: HorizontalLayout {
            spacing: 12px;

            Rectangle {
                width: 220px;
                background: Theme.surface;
                border-radius: 8px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: Strings.signed-in-label + " " + root.signed-in-as;
                        color: Theme.text-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    NavButton {
                        label: Strings.nav-users;
                        active: root.page == 0;
                        clicked => { root.page = 0; root.select-page(0); }
                    }
                    NavButton {
                        label: Strings.nav-settings;
                        active: root.page == 1;
                        clicked => { root.page = 1; }
                    }
                    NavButton {
                        label: Strings.nav-profiles;
                        active: root.page == 2;
                        clicked => { root.page = 2; }
                    }
                    if root.is-all-father: NavButton {
                        label: Strings.nav-organizations;
                        active: root.page == 3;
                        clicked => { root.page = 3; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Button {
                        text: Strings.sign-out-button;
                        clicked => { root.sign-out(); }
                    }
                }
            }

            Rectangle {
                background: Theme.surface;
                border-radius: 8px;
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: root.page == 0 ? Strings.nav-users
                            : root.page == 1 ? Strings.nav-settings
                            : root.page == 2 ? Strings.nav-profiles
                            : Strings.nav-organizations;
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 700;
                    }
                    if root.page == 0 && root.users-loading: Text {
                        text: Strings.loading;
                        color: Theme.text-dim;
                    }
                    if root.page == 0 && root.users-error != "": Text {
                        text: root.users-error;
                        color: Theme.danger;
                        wrap: word-wrap;
                    }
                    if root.page == 0: VerticalLayout {
                        spacing: 8px;
                        for item in root.users: Text {
                            text: item.username + " · " + item.detail + " · " + (item.active ? Strings.status-active : Strings.status-inactive);
                            color: Theme.text;
                        }
                    }
                    if root.page != 0: Text {
                        text: Strings.no-data;
                        color: Theme.text-dim;
                    }
                }
            }
        }
    }
}
