{
  "productName": "ONYX Admin",
  "version": "1.0.0",
  "identifier": "com.onyx.admin",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ONYX Admin",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "admin-main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/icons/hicolor/16x16/apps/admin-shell.png": "icons/hicolor/16x16/apps/admin-shell.png",
          "/usr/share/icons/hicolor/22x22/apps/admin-shell.png": "icons/hicolor/22x22/apps/admin-shell.png",
          "/usr/share/icons/hicolor/24x24/apps/admin-shell.png": "icons/hicolor/24x24/apps/admin-shell.png",
          "/usr/share/icons/hicolor/32x32/apps/admin-shell.png": "icons/hicolor/32x32/apps/admin-shell.png",
          "/usr/share/icons/hicolor/48x48/apps/admin-shell.png": "icons/hicolor/48x48/apps/admin-shell.png",
          "/usr/share/icons/hicolor/64x64/apps/admin-shell.png": "icons/hicolor/64x64/apps/admin-shell.png",
          "/usr/share/icons/hicolor/96x96/apps/admin-shell.png": "icons/hicolor/96x96/apps/admin-shell.png",
          "/usr/share/icons/hicolor/128x128/apps/admin-shell.png": "icons/hicolor/128x128/apps/admin-shell.png",
          "/usr/share/icons/hicolor/256x256/apps/admin-shell.png": "icons/hicolor/256x256/apps/admin-shell.png",
          "/usr/share/icons/hicolor/512x512/apps/admin-shell.png": "icons/hicolor/512x512/apps/admin-shell.png"
        }
      }
    }
  }
}
