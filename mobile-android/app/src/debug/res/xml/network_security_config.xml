<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only: permits cleartext (plain HTTP) traffic to any host.

  Real, necessary correction found while building A3, not present in
  the frozen Flutter reference: AuthApi's login flow talks to a
  server address the user types in, e.g. http://192.168.1.x:3000 (a
  LAN api-server instance, matching this project's local-first
  design) - plain HTTP, not HTTPS. Since API 28, Android blocks
  cleartext network traffic by default for every app unless it opts
  in via a network security config. Checked directly: neither
  mobile/android/app/src/main/AndroidManifest.xml nor any
  res/xml/network_security_config.xml exists anywhere under
  mobile/android/ - the frozen Dart/Flutter app has no such
  opt-in, meaning its own real LAN HTTP login is very likely blocked
  by the OS on a real API 28+ device today. That is the frozen
  reference's own pre-existing, undisclosed gap (out of scope to fix
  here per the M0 freeze, flagged in this task's DECISIONS.md entry
  instead), not something to silently reproduce identically in the
  Kotlin rewrite.

  Scoped to the debug source set only (src/debug/res/xml/, not
  src/main/) so a release build never silently allows cleartext -
  a real production deployment would need TLS on api-server or a
  scoped domain-config naming its actual real host, not a
  blanket allow.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
