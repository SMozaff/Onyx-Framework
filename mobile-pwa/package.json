{
  "name": "onyx-mobile-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ONYX ObserverClient PWA — read-only browser client for the mobile_observer client class (MIGRATION_PLAN Phase 2).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/render-sw.mjs",
    "preview": "vite preview",
    "test": "vitest run --reporter=default",
    "test:watch": "vitest",
    "test:component": "vitest run tests/component",
    "test:a11y": "vitest run tests/accessibility",
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report",
    "pretest:browser:offline": "VITE_API_BASE=http://localhost:5175 npm run build",
    "test:browser:offline": "playwright test --config=playwright.offline.config.ts",
    "type-check": "tsc -b --pretty false",
    "lint": "eslint src tests --max-warnings=0",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "date-fns": "^2.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@axe-core/react": "^4.7.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^23.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
