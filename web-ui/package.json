{
  "name": "onyx-web-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run bundle-check",
    "preview": "vite preview",
    "test": "vitest run --reporter=default --reporter=junit --outputFile.junit=test-reports/junit.xml",
    "test:watch": "vitest",
    "test:a11y": "vitest run tests/accessibility",
    "test:e2e": "vitest run tests/e2e",
    "feature-audit": "vitest run tests/feature-audit",
    "type-check": "tsc -b --pretty false",
    "lint": "eslint src tests --max-warnings=0",
    "bundle-check": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "axios": "^1.6.0",
    "zustand": "^4.4.0",
    "@tanstack/react-query": "^5.0.0",
    "date-fns": "^2.30.0",
    "clsx": "^2.0.0",
    "recharts": "^2.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "vitest": "^1.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@axe-core/react": "^4.7.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "msw": "^2.0.0",
    "jsdom": "^23.0.0",
    "vitest-axe": "^0.1.0",
    "@types/node": "^20.0.0"
  }
}
